---
/**
 * Vignette d'image : fond background-muted, image contenue et centrée avec
 * de l'air autour (captures d'apps, mockups).
 *
 * aspect : "square", "video" (carré sur mobile, 16:9 dès md) ou "wide"
 * (16:9 partout). padding : marge autour de l'image ("15%" par défaut,
 * "none" pour une image qui remplit le cadre en cover).
 * video : MP4 muet en boucle (LoopVideo) à la place de l'image, qui devient
 * son poster ; même cadre et mêmes marges.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import LoopVideo from "./LoopVideo.astro";

export interface Props {
  image?: ImageMetadata | null;
  /** Chemin public d'un MP4 (optionnel). */
  video?: string | null;
  alt: string;
  aspect?: "square" | "video" | "wide";
  padding?: "15%" | "3rem" | "none";
  href?: string;
  sizes?: string;
  class?: string;
}

const {
  image,
  video,
  alt,
  aspect = "square",
  padding = "15%",
  href,
  sizes,
  class: extraClass,
} = Astro.props;

const containerClass = [
  "w-full bg-background-muted flex items-center justify-center overflow-hidden",
  aspect === "video"
    ? "aspect-square md:aspect-video"
    : aspect === "wide"
      ? "aspect-video"
      : "aspect-square",
  extraClass,
];
const imageClass = [
  "w-full h-full",
  padding === "none" ? "object-cover" : "object-contain",
  padding === "15%" && "p-[15%]",
  padding === "3rem" && "p-12",
];
const Tag = href ? "a" : "div";
---

<Tag class:list={containerClass} href={href}>
  {
    video ? (
      <LoopVideo src={video} poster={image} class:list={imageClass} label={alt} />
    ) : (
      image && <Image src={image} alt={alt} class:list={imageClass} sizes={sizes} />
    )
  }
</Tag>
