---
/**
 * Footer partagé de la galaxie hien.design.
 * Squelette fixe (bloc CTA sur fond mesh, crédit, navigation). Les textes et
 * liens viennent de chaque site, en général du singleton Keystatic "Footer".
 * Dépendances côté site : @lucide/astro et @paper-design/shaders.
 * meshFixed : le fond animé couvre tout le viewport (voir MeshBackground).
 * Slot background : remplace le mesh (cv.hien.design), sur le même fond noir.
 */
import { SITES, siteHref, siteNav, type SiteKey } from "./sites.js";
import MeshBackground from "./MeshBackground.astro";
import Button from "./Button.astro";

type Link = { label: string; href: string };

export interface Props {
  /** Site qui affiche le footer : son lien pointe sur "/" et reste masqué sur l'accueil. */
  currentSite?: SiteKey;
  /** Affiche la navigation entre les sites (Portfolio, Playground, Indie Apps, CV). */
  showSiteNav?: boolean;
  /** Ajoute un lien Home vers "/" en tête de liste (masqué sur la page d'accueil). */
  homeLink?: boolean;
  availabilityLabel?: string | null;
  /** Décoché : la ligne de disponibilité est masquée. */
  isAvailable?: boolean | null;
  /** Un "?" coupe le titre en deux : la suite passe en gris sur une 2e ligne. */
  heading?: string | null;
  ctaLabel?: string | null;
  /** Adresse du bouton : mailto:ctaEmail par défaut, ou ctaHref s'il est fourni. */
  ctaEmail?: string | null;
  ctaHref?: string | null;
  /** Liens du CMS, dans un second groupe sous la navigation entre les sites.
      Un lien sans libellé ou sans adresse est ignoré. */
  navLinks?: { label?: string | null; href?: string | null }[] | null;
  /** Les liens http s'ouvrent dans un nouvel onglet. */
  externalInNewTab?: boolean;
  credit?: string | null;
  /** Heure de Paris après le crédit. */
  showTime?: boolean;
  /** Fond animé fixé au viewport, visible derrière toute la page (apps). */
  meshFixed?: boolean;
}

const {
  currentSite,
  showSiteNav = true,
  homeLink = false,
  availabilityLabel,
  isAvailable,
  heading,
  ctaLabel,
  ctaEmail,
  ctaHref,
  navLinks,
  externalInNewTab = false,
  credit,
  showTime = true,
  meshFixed = false,
} = Astro.props;

const available = isAvailable ?? true;
const label = availabilityLabel || "Available for freelance work";
const title = heading || "Let's work together";
const [, titleLead = title, titleRest = ""] =
  title.match(/^(.*?\?)\s*(.+)$/) ?? [];
const cta = ctaLabel || "Get in touch";
const href = ctaHref || `mailto:${ctaEmail || "gauthier@hien.design"}`;
const hoverLabel = href.startsWith("mailto:")
  ? href.slice("mailto:".length).split("?")[0]
  : undefined;
const creditText = credit || "Designed & built by Gauthier Hien in Paris, France";

// Les liens relatifs vers la page courante sont masqués.
// build.format "directory" : le pathname peut finir par un slash.
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (target: string) => {
  if (!target.startsWith("/")) return false;
  const path = target.replace(/\/+$/, "") || "/";
  return path === "/"
    ? currentPath === "/"
    : currentPath === path || currentPath.startsWith(`${path}/`);
};
const siteRoots = Object.values(SITES);
const isSiteLink = (href: string) =>
  siteRoots.some((root) => href.replace(/\/+$/, "") === root);
const internalLinks: Link[] = showSiteNav
  ? siteNav
      .map((link) => ({ label: link.label, href: siteHref(link.site, currentSite) }))
      .filter((link) => !isCurrent(link.href))
  : [];
// Avec la navigation entre sites, un lien du CMS vers l'accueil d'un site ferait doublon.
const links: Link[] = [
  ...(homeLink ? [{ label: "Home", href: "/" }] : []),
  ...(navLinks
    ? navLinks.filter((link): link is Link => Boolean(link?.label && link?.href))
    : [
        { label: "LinkedIn", href: "https://www.linkedin.com/in/gauthierhien/" },
        { label: "Mail", href: "mailto:gauthier@hien.design" },
      ]),
].filter((link) => !isCurrent(link.href) && !(showSiteNav && isSiteLink(link.href)));
---

<footer class="footer-root theme-dark text-foreground p-4" data-mesh-root>
  <slot name="background">
    <MeshBackground fixed={meshFixed} />
  </slot>
  <div class="relative z-10">
    <!-- CTA Container -->
    <div class="2xl:grid 2xl:grid-cols-8">
      <div class="footer-cta-container aspect-square md:aspect-auto border border-border p-4 md:p-16 flex flex-col gap-16 2xl:col-start-3 2xl:col-span-4">
        <!-- Subtitle + Title -->
        <div class="flex-1 flex flex-col space-between gap-2">
          <!-- Subtitle with LED, hidden when unavailable -->
          {available && (
            <div class="flex items-center gap-2">
              <span
                class="led-pulse w-2 h-2 rounded-full flex-shrink-0"
                style="background-color: var(--status);"
              ></span>
              <span class="font-mono text-foreground uppercase">
                {label}
              </span>
            </div>
          )}

          <!-- Heading -->
          <h2 class:list={["mb-0", titleRest && "footer-heading"]}>
            {titleRest ? (
              <>
                <span class="footer-heading-lead">{titleLead}</span>
                <span class="footer-heading-rest">{titleRest}</span>
              </>
            ) : (
              title
            )}
          </h2>
        </div>

        <!-- Button -->
        <Button
          href={href}
          label={cta}
          hoverLabel={hoverLabel}
          size="lg"
          meshTrigger
          class="footer-cta-btn flex-none h-fit"
        />
      </div>
    </div>

    <!-- Bottom Section -->
    <div class="2xl:grid 2xl:grid-cols-8">
      <div class="flex flex-row gap-4 mt-4 mb-16 2xl:mb-40 2xl:col-start-3 2xl:col-span-4">
        <!-- Product Designer Info -->
        <div class="flex-1 flex flex-col md:flex-row md:gap-2 items-start">
          <span class="text-muted">
            {creditText}
            {showTime && (
              <>
                <span class="hidden md:inline"> · </span>
                <span class="md:hidden">
                  <br />
                </span>
                <span id="footer-paris-time"></span>
              </>
            )}
          </span>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 flex flex-col gap-2" aria-label="Footer">
          {internalLinks.length > 0 && (
            <ul class="flex flex-col gap-2">
              {internalLinks.map((link) => (
                <li>
                  <a href={link.href} class="font-mono text-xs md:text-sm">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {links.length > 0 && (
            <ul class="flex flex-col gap-2">
              {links.map((link) => {
                const newTab = externalInNewTab && link.href.startsWith("http");
                return (
                  <li>
                    <a
                      href={link.href}
                      target={newTab ? "_blank" : "_self"}
                      rel="noopener noreferrer"
                      class="font-mono text-xs md:text-sm"
                    >
                      {link.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  @keyframes led-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  .led-pulse {
    animation: led-pulse 2s ease-in-out infinite;
  }

  .footer-root {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: oklch(0 0 0);
  }

  .footer-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-heading-lead,
  .footer-heading-rest {
    font-family: var(--font-sans);
    font-size: inherit;
    font-weight: 500;
    letter-spacing: inherit;
    line-height: inherit;
  }

  .footer-heading-rest {
    color: var(--foreground-muted);
    transition:
      color var(--duration-hover) ease,
      opacity var(--duration-hover) ease;
  }

  .footer-root:has(.footer-cta-btn:hover) .footer-heading-rest,
  .footer-root:has(.footer-cta-btn:focus-visible) .footer-heading-rest,
  .footer-root.is-mesh-active .footer-heading-rest {
    color: var(--foreground);
    opacity: 0.5;
  }

  .footer-cta-container {
    transition: border-color var(--duration-hover) ease; /* Ajout pour la fluidité */
  }

  .footer-root:has(.footer-cta-btn:hover) .footer-cta-container,
  .footer-root:has(.footer-cta-btn:focus-visible) .footer-cta-container,
  .footer-root.is-mesh-active .footer-cta-container {
    border-color: var(--foreground);
  }

  /* 2. Changement de couleur des textes "muted" (Product Designer Info) */
  .text-muted {
    transition: color var(--duration-hover) ease; /* Ajout pour la fluidité */
  }

  /* On cible spécifiquement les éléments .text-muted quand le root est activé */
  .footer-root:has(.footer-cta-btn:hover) .text-muted,
  .footer-root:has(.footer-cta-btn:focus-visible) .text-muted,
  .footer-root.is-mesh-active .text-muted {
    color: var(--foreground);
  }
</style>

<script>
  function updateFooterParisTime() {
    const timeElement = document.getElementById("footer-paris-time");
    if (!timeElement) return;

    const parisTime = new Date().toLocaleTimeString("en-US", {
      timeZone: "Europe/Paris",
      hour: "2-digit",
      minute: "2-digit",
      hour12: true,
    });

    timeElement.textContent = parisTime;
  }

  updateFooterParisTime();
  setInterval(updateFooterParisTime, 1000);

  document.addEventListener("astro:page-load", () => {
    updateFooterParisTime();
  });
</script>
