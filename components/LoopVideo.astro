---
/**
 * Clip MP4 muet en boucle, à la place d'une image (captures, projets).
 * L'image éventuelle sert de poster. `eager` charge tout de suite ; sinon la
 * source n'est posée qu'à l'approche du viewport. Pause hors écran. Avec
 * prefers-reduced-motion : pas d'autoplay, poster + contrôles.
 * Même comportement que LoopVideo d'apps.hien.design.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  /** Chemin public du MP4 (ex. /videos/projects/clip.mp4). */
  src: string;
  poster?: ImageMetadata | null;
  posterWidth?: number;
  class?: string;
  /** Texte alternatif ; sans label la vidéo est décorative (aria-hidden). */
  label?: string | null;
  eager?: boolean;
}

const {
  src,
  poster,
  posterWidth = 1440,
  class: className,
  label,
  eager = false,
} = Astro.props;

const posterUrl = poster
  ? (
      await getImage({
        src: poster,
        width: Math.min(posterWidth, poster.width),
        format: "webp",
      })
    ).src
  : undefined;
---

<video
  class={className}
  data-loop-video
  src={eager ? src : undefined}
  data-src={eager ? undefined : src}
  poster={posterUrl}
  autoplay
  muted
  loop
  playsinline
  disablepictureinpicture
  preload={eager ? "auto" : "none"}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : "true"}
></video>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const observer = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const video = target as HTMLVideoElement;
        if (!isIntersecting) {
          video.pause();
          continue;
        }
        if (!video.getAttribute("src") && video.dataset.src) {
          video.src = video.dataset.src;
        }
        if (!reduceMotion.matches) video.play().catch(() => {});
      }
    },
    { rootMargin: "200px 0px" },
  );

  function initLoopVideos() {
    document
      .querySelectorAll<HTMLVideoElement>("video[data-loop-video]:not([data-ready])")
      .forEach((video) => {
        video.dataset.ready = "";
        if (reduceMotion.matches) {
          video.autoplay = false;
          video.pause();
          video.controls = true;
        }
        observer.observe(video);
      });
  }

  initLoopVideos();
  document.addEventListener("astro:page-load", initLoopVideos);
</script>
