---
/**
 * Charge Geist et Geist Mono déclarées par geistFonts() (astro.config) :
 * @font-face, police de secours calée et <link rel="preload">. À placer
 * en haut du <head>.
 */
import { Font } from "astro:assets";
---

<Font cssVariable="--font-geist" preload />
<Font cssVariable="--font-geist-mono" preload />
