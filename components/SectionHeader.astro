---
/**
 * En-tête de section : badge, titre H2 et paragraphe, tous optionnels, sur
 * la colonne des modules (4 colonnes sur 6 dès md, sur 8 en 2xl). Le slot
 * "aside" se place à droite du paragraphe dès md (flèches d'un carrousel).
 *
 * bleed : la section parente n'a pas de marge latérale (carrousel) ; la
 * grille se cale alors sur toute la largeur et garde 16px sur mobile.
 *
 * link : lien souligné à la suite du paragraphe (« Learn more » par défaut),
 * vers la page détail d'un projet ou d'une app, comme sur apps.hien.design.
 * Sans link, le rendu ne change pas.
 *
 * details : lignes libellé / valeur sous le texte (ex. Judgment, Leverage,
 * Proof sur hien.design). placeholder : valeur encore à écrire, affichée
 * dans un cadre gris en pointillé. Sans details, le rendu ne change pas.
 */
import Tag from "./Tag.astro";
import SectionText from "./SectionText.astro";

export interface SectionLink {
  href?: string | null;
  /** Défaut : « Learn more ». */
  label?: string | null;
  /** Texte lu par les lecteurs d'écran, ex. « Learn more about Chanel ». */
  ariaLabel?: string | null;
  target?: string | null;
}

export interface SectionDetail {
  label?: string | null;
  value?: string | null;
  placeholder?: boolean;
}

export interface Props {
  tag?: string | null;
  heading?: string | null;
  body?: string | null;
  bleed?: boolean;
  link?: SectionLink | null;
  details?: (SectionDetail | null)[] | null;
  class?: string;
}

const { tag, heading, body, bleed = false, link, details: rawDetails, class: extraClass } = Astro.props;
const details = (rawDetails ?? []).filter(
  (detail): detail is SectionDetail => Boolean(detail?.label && detail?.value),
);
const hasAside = Astro.slots.has("aside");
const textProps = {
  body,
  href: link?.href || null,
  label: link?.label || "Learn more",
  ariaLabel: link?.ariaLabel,
  target: link?.target,
};
const text = body || textProps.href;
const show = tag || heading || text || hasAside || details.length > 0;
---

{
  show && (
    <div
      class:list={[
        "w-full flex flex-col md:grid md:grid-cols-6 2xl:grid-cols-8",
        bleed && "px-4 md:px-0",
        extraClass,
      ]}
    >
      <div class="md:col-start-2 2xl:col-start-3 md:col-span-4">
        {tag && <Tag>{tag}</Tag>}
        {heading && <h2>{heading}</h2>}
        {hasAside ? (
          <div class="flex items-end justify-between gap-4">
            {text ? <SectionText {...textProps} /> : <span />}
            <slot name="aside" />
          </div>
        ) : (
          text && <SectionText {...textProps} />
        )}
        {details.length > 0 && (
          <dl class="hd-section-details max-w-2xl mt-6 md:mt-8 border-b border-border">
            {details.map((detail) => (
              <div class="grid grid-cols-[6.5rem_1fr] md:grid-cols-[8rem_1fr] gap-4 py-3 border-t border-border">
                <dt>
                  <span>{detail.label}</span>
                </dt>
                <dd class="m-0">
                  <p class:list={[detail.placeholder && "hd-placeholder"]}>{detail.value}</p>
                </dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </div>
  )
}

<style>
  .hd-placeholder {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border: 1px dashed var(--foreground-muted);
    color: var(--foreground);
  }
</style>
