---
import Docs from "../layouts/Docs.astro";
import { type } from "../data";
---

<Docs
  title="Typography"
  lead="Geist Variable for headings and text, Geist Mono Variable for labels, metadata and times. Sizes step up at the md, lg, xl and 2xl breakpoints: resize the window."
>
  <ul class="border-b border-border divide-y divide-border">
    {
      type.map((t) => {
        const El = t.el as any;
        return (
          <li class="px-4 md:px-8 py-8 flex flex-col gap-3 md:flex-row md:items-baseline md:gap-8">
            <span class="text-muted md:w-32 shrink-0">text-{t.name}</span>
            <El class={`mb-0 ${t.cls ?? ""}`}>{t.sample}</El>
          </li>
        );
      })
    }
  </ul>
</Docs>
