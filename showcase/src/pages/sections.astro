---
import Docs from "../layouts/Docs.astro";
import Demo from "../components/Demo.astro";
import SectionHeader from "@hien/design-tokens/SectionHeader.astro";
import SectionImageWide from "@hien/design-tokens/SectionImageWide.astro";
import SectionImageGrid from "@hien/design-tokens/SectionImageGrid.astro";
import app1 from "../assets/app-1.png";
import app2 from "../assets/app-2.png";
import hero from "../assets/hero.jpg";
---

<Docs
  title="Sections"
  lead="The sites' page blocks: a header (tag, heading, text, all optional) combined with a wide image or an image grid. Vertical spacing between sections stays with the site."
>
  <Demo label="SectionHeader · tag, heading, text" bleed code={`<SectionHeader tag="Currently" heading="…" body="…" />`}>
    <div class="px-4">
      <SectionHeader tag="Currently" heading="I help Sonepar build an AI-native product experience" body="Every part is optional." />
    </div>
  </Demo>
  <Demo label="SectionHeader · link to the detail page" bleed code={`<SectionHeader tag="Previously" heading="…" body="…"
  link={{ href: "/chanel", ariaLabel: "Learn more about Chanel" }} />`}>
    <div class="px-4">
      <SectionHeader tag="Previously" heading="I crafted interfaces at Chanel" body={'The link follows the text, underlined, "Learn more" by default (use label to change it).'} link={{ href: "#", ariaLabel: "Learn more about Chanel" }} />
    </div>
  </Demo>
  <Demo label="SectionImageWide · wide image, header below (Module A)" bleed code={`<SectionImageWide image={img} tag="Currently" heading="…" body="…" />`}>
    <SectionImageWide image={hero} tag="Currently" heading="I help Sonepar build an AI-native product experience" body="The header only shows when it has content." />
  </Demo>
  <Demo label="SectionImageWide · header above, whole image (contain), caption" bleed code={`<SectionImageWide image={img} fit="contain" heading="Picky" headerPosition="before" caption="…" />`}>
    <SectionImageWide image={app2} fit="contain" heading="Picky" headerPosition="before" caption="Color picker for Mac" />
  </Demo>
  <Demo label="SectionImageWide · with a link to the detail page" bleed code={`<SectionImageWide image={img} tag="Currently" heading="…" link={{ href: "/sonepar" }} />`}>
    <SectionImageWide image={hero} tag="Currently" heading="I help Sonepar build an AI-native product experience" link={{ href: "#" }} />
  </Demo>
  <Demo label="SectionImageWide · no heading" bleed code={`<SectionImageWide image={img} />`}>
    <SectionImageWide image={hero} />
  </Demo>
  <Demo label="SectionImageGrid · several square images, lightbox on click (Module B)" bleed code={`<SectionImageGrid tag="…" heading="…" body="…" items={[img1, img2]} lightbox />`}>
    <SectionImageGrid tag="Side-projects" heading="Square images" body="A single image becomes a wide image." items={[app1, app2]} lightbox />
  </Demo>
  <Demo label="SectionImageGrid · with a link to the detail page (Module B)" bleed code={`<SectionImageGrid tag="…" heading="…" body="…" items={[img1, img2]} lightbox
  link={{ href: "/chanel", label: "See the project" }} />`}>
    <SectionImageGrid tag="Previously" heading="I crafted interfaces at Chanel" body="Change the link text with label." items={[app2, app1]} lightbox link={{ href: "#", label: "See the project" }} />
  </Demo>
  <Demo label="SectionImageGrid · a single image, no heading" bleed code={`<SectionImageGrid items={[img]} />`}>
    <SectionImageGrid items={[app1]} />
  </Demo>
  <Demo label="SectionImageGrid · 3 columns, captions and links" bleed code={`<SectionImageGrid heading="…" columns={3} items={[{ image, caption, href }, …]} />`}>
    <SectionImageGrid
      heading="Three columns"
      columns={3}
      items={[
        { image: app1, caption: "Countdowns", href: "https://apps.hien.design" },
        { image: app2, caption: "Picky", href: "https://apps.hien.design" },
        { image: app1, caption: "Boring Countdown" },
      ]}
    />
  </Demo>
  <Demo label={'SectionImageGrid · "+" pill on a gradient (Module D)'} bleed code={`<SectionImageGrid items={[…]} cta={{ label: "See all projects", href: "…" }} />`}>
    <SectionImageGrid items={[app1, app2, app2, app1]} cta={{ label: "See all projects", href: "https://feed.hien.design" }} />
  </Demo>
</Docs>
