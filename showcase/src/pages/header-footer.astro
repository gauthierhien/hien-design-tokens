---
import Docs from "../layouts/Docs.astro";
import Demo from "../components/Demo.astro";
import Header from "@hien/design-tokens/Header.astro";
import Footer from "@hien/design-tokens/Footer.astro";
---

<Docs
  title="Header and Footer"
  lead="The same skeleton on all four sites. Each site only reads its Keystatic (Header and Footer singletons, shipped by the package) and passes the content as props."
>
  <Demo
    label="Header · tagline and logo"
    bleed
    code={`---
import { getEntry } from "astro:content";
import Header from "@hien/design-tokens/Header.astro";
const header = await getEntry("header-data", "index");
---
<Header currentSite="feed" tagline={header?.data?.tagline} />`}
  >
    <div class="border-y border-border overflow-hidden">
      <Header currentSite="home" tagline="Design Engineer" />
    </div>
  </Demo>
  <Demo
    label="Footer · hien.design, feed and cv (navigation between sites, Paris time)"
    bleed
    code={`<Footer currentSite="feed" {...footer?.data} />`}
  >
    <Footer
      currentSite="home"
      heading="What will we ship together?"
      navLinks={[
        { label: "GitHub", href: "https://github.com/gauthierhien/hien-design-tokens" },
        { label: "hien.design", href: "https://hien.design" },
      ]}
    />
  </Demo>
  <section class="px-4 md:px-8 py-12 border-b border-border">
    <h3 class="mb-6">Options</h3>
    <ul class="divide-y divide-border border-y border-border">
      {
        [
          ["currentSite", "home, feed or cv: logo link and navigation between sites."],
          ["heading", "A \"?\" splits the heading; the rest goes grey on a second line."],
          ["ctaEmail, ctaHref", "Button target; hovering shows the email address."],
          ["isAvailable", "Unchecked: the availability line is hidden."],
          ["showSiteNav, homeLink, externalInNewTab, showTime", "Navigation structure (apps: no navigation between sites, a Home link, no time)."],
          ["meshFixed", "The animated background covers the whole viewport (apps)."],
        ].map(([k, v]) => (
          <li class="grid grid-cols-1 md:grid-cols-8 gap-2 md:gap-4 py-4">
            <span class="md:col-span-3">{k}</span>
            <p class="md:col-span-5 text-muted">{v}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Docs>
