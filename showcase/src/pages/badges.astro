---
import Docs from "../layouts/Docs.astro";
import Demo from "../components/Demo.astro";
import Tag from "@hien/design-tokens/Tag.astro";
---

<Docs title="Badges" lead="Uppercase mono on solid ink. 1rem bottom margin by default, above a heading.">
  <Demo label="Tag" code={`<Tag>Side-projects</Tag>
<Tag class="mb-0">About</Tag>   <!-- no bottom margin -->`}>
    <div class="flex flex-wrap gap-2">
      <Tag class="mb-0">Side-projects</Tag>
      <Tag class="mb-0">About</Tag>
      <Tag class="mb-0">Services</Tag>
      <Tag class="mb-0">Currently</Tag>
    </div>
  </Demo>
  <Demo label="Above a heading">
    <Tag>Side-projects</Tag>
    <h2 class="mb-0">In my spare time, I have fun building my own ideas</h2>
  </Demo>
</Docs>
