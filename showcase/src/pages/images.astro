---
import Docs from "../layouts/Docs.astro";
import Demo from "../components/Demo.astro";
import ImageWide from "@hien/design-tokens/ImageWide.astro";
import ImageSquare from "@hien/design-tokens/ImageSquare.astro";
import Thumbnail from "@hien/design-tokens/Thumbnail.astro";
import Lightbox from "@hien/design-tokens/Lightbox.astro";
import app1 from "../assets/app-1.png";
import app2 from "../assets/app-2.png";
import hero from "../assets/hero.jpg";
---

<Docs
  title="Images"
  lead="Wide image and square image: grey background, the whole image with room around it (contain) or filling the frame (cover). Optional caption and link, or opening the lightbox."
>
  <Demo label="ImageWide · square on mobile, 16:9 from md, no caption" code={`<ImageWide image={img} alt="…" />`}>
    <ImageWide image={app1} alt="App screenshot" />
  </Demo>
  <Demo label="ImageWide · caption and link (↗ arrow, new tab)" code={`<ImageWide image={img} caption="Picky" href="https://…" padding="3rem" />`}>
    <ImageWide image={app2} alt="Picky" caption="Picky" href="https://apps.hien.design" padding="3rem" />
  </Demo>
  <Demo label="ImageWide · cover, 16:9 everywhere, caption without a link" code={`<ImageWide image={img} fit="cover" responsive={false} caption="…" />`}>
    <ImageWide image={hero} alt="" fit="cover" responsive={false} caption="Sonepar, voice assistant" />
  </Demo>
  <Demo label="ImageSquare · no caption, caption, caption and link" code={`<ImageSquare image={img} caption="Countdowns" href="https://…" />`}>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-1">
      <ImageSquare image={app1} alt="Countdowns" />
      <ImageSquare image={app2} alt="Picky" caption="Picky" />
      <ImageSquare image={app1} alt="Countdowns" caption="Countdowns" href="https://apps.hien.design" />
    </div>
  </Demo>
  <Demo
    label="Lightbox · clicking the image opens it (Esc closes)"
    code={`<ImageSquare image={img} lightbox={{ id: "demo", index: 0 }} />
<Lightbox id="demo" images={[{ src: img, alt: "…" }]} />`}
  >
    <div class="grid grid-cols-2 gap-1">
      <ImageSquare image={app1} alt="Countdowns" lightbox={{ id: "images-demo", index: 0 }} />
      <ImageSquare image={app2} alt="Picky" lightbox={{ id: "images-demo", index: 1 }} />
    </div>
    <Lightbox id="images-demo" images={[{ src: app1, alt: "Countdowns" }, { src: app2, alt: "Picky" }]} />
  </Demo>
  <Demo label="Thumbnail · the base tile, no caption or link" code={`<Thumbnail image={img} alt="…" aspect="square" />`}>
    <div class="grid grid-cols-2 gap-1">
      <Thumbnail image={app1} alt="App screenshot" />
      <Thumbnail image={app2} alt="App screenshot" />
    </div>
  </Demo>
</Docs>
