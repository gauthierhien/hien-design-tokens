---
import Docs from "../layouts/Docs.astro";
import Demo from "../components/Demo.astro";
import Carousel from "@hien/design-tokens/Carousel.astro";
import app1 from "../assets/app-1.png";
import app2 from "../assets/app-2.png";
---

<Docs
  title="Carousel"
  lead="Swiper, a header with previous and next arrows from md, wide-image slides that bleed past the grid. Every other slide is offset at 2xl. Built for full page width."
>
  <Demo
    label="Carousel · with tag, heading and text (Module C)"
    bleed
    code={`<Carousel tag="Side-projects" heading="…" body="…"
  items={[{ image, title: "Countdowns", link: "https://…" }, …]} />`}
  >
    <Carousel
      tag="Side-projects"
      heading="In my spare time, I have fun building my own ideas"
      body="Like the ultimate screenshot tool I hope to launch this year."
      items={[
        { image: app1, title: "Countdowns" },
        { image: app2, title: "Picky", link: "https://apps.hien.design" },
        { image: app1, title: "Boring Countdown" },
        { image: app2, title: "Hey Calendar" },
      ]}
    />
  </Demo>
  <Demo
    label="Carousel · with a link to the detail page"
    bleed
    code={`<Carousel tag="…" heading="…" body="…" link={{ href: "/app/countdowns" }} items={[…]} />`}
  >
    <Carousel
      tag="Side-projects"
      heading="Countdowns"
      body="The link follows the text; the arrows stay on the right."
      link={{ href: "#" }}
      items={[{ image: app1, title: "Countdowns" }, { image: app2 }, { image: app1 }]}
    />
  </Demo>
  <Demo label="Carousel · no header" bleed code={`<Carousel items={[…]} />`}>
    <Carousel items={[{ image: app2 }, { image: app1 }, { image: app2 }]} />
  </Demo>
</Docs>
