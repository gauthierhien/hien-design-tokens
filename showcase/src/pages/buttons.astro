---
import Docs from "../layouts/Docs.astro";
import Demo from "../components/Demo.astro";
import Button from "@hien/design-tokens/Button.astro";
import { Image } from "astro:assets";
import hero from "../assets/hero.jpg";
---

<Docs title="Buttons" lead="The full-width pill behind Full resume, Get in touch and Download on the App Store, and its compact version.">
  <Demo label="outline, md (default)" code={`<Button href="https://cv.hien.design" label="Full resume" />`}>
    <Button href="https://cv.hien.design" label="Full resume" />
  </Demo>
  <Demo label="outline, lg, label swap on hover (footer)" code={`<Button href="mailto:…" label="Get in touch" hoverLabel="gauthier@hien.design" size="lg" />`}>
    <Button href="mailto:gauthier@hien.design" label="Get in touch" hoverLabel="gauthier@hien.design" size="lg" />
  </Demo>
  <Demo label="disabled (no link)" code={`<Button label="Soon" />`}>
    <Button label="Soon" />
  </Demo>
  <Demo label="overlay, on an image" code={`<Button href="…" label="Download on the App Store" variant="overlay" target="_blank" />`}>
    <div class="relative aspect-video overflow-hidden border border-border">
      <Image src={hero} alt="" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 flex items-center justify-center p-4 md:p-16">
        <Button href="https://apps.hien.design" label="Download on the App Store" variant="overlay" target="_blank" />
      </div>
    </div>
  </Demo>
  <Demo label="compact, plus icon (portfolio image grids)" code={`<Button href="…" label="See all projects" variant="compact" icon="plus" />`}>
    <Button href="https://playground.hien.design" label="See all projects" variant="compact" icon="plus" />
  </Demo>
</Docs>
