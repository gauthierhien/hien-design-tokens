{
  "name": "@hien/design-tokens",
  "version": "1.14.0",
  "description": "Brand design tokens and shared Astro components for the hien.design sites",
  "license": "MIT",
  "type": "module",
  "files": [
    "theme.css",
    "base.css",
    "prose.css",
    "DESIGN.md",
    "components"
  ],
  "exports": {
    "./theme.css": "./theme.css",
    "./base.css": "./base.css",
    "./prose.css": "./prose.css",
    "./DESIGN.md": "./DESIGN.md",
    "./Header.astro": "./components/Header.astro",
    "./Footer.astro": "./components/Footer.astro",
    "./sites": {
      "types": "./components/sites.d.ts",
      "default": "./components/sites.js"
    },
    "./keystatic": {
      "types": "./components/keystatic.d.ts",
      "default": "./components/keystatic.js"
    },
    "./package.json": "./package.json",
    "./Button.astro": "./components/Button.astro",
    "./Tag.astro": "./components/Tag.astro",
    "./Thumbnail.astro": "./components/Thumbnail.astro",
    "./Carousel.astro": "./components/Carousel.astro",
    "./MeshBackground.astro": "./components/MeshBackground.astro",
    "./mesh": "./components/mesh.ts",
    "./ImageWide.astro": "./components/ImageWide.astro",
    "./ImageSquare.astro": "./components/ImageSquare.astro",
    "./SectionHeader.astro": "./components/SectionHeader.astro",
    "./SectionImageWide.astro": "./components/SectionImageWide.astro",
    "./SectionImageGrid.astro": "./components/SectionImageGrid.astro",
    "./Lightbox.astro": "./components/Lightbox.astro",
    "./LoopVideo.astro": "./components/LoopVideo.astro",
    "./videos": {
      "types": "./components/videos.d.ts",
      "default": "./components/videos.js"
    },
    "./content": "./components/content.ts",
    "./breakpoints": {
      "types": "./components/breakpoints.d.ts",
      "default": "./components/breakpoints.js"
    },
    "./fonts": {
      "types": "./components/fonts.d.ts",
      "default": "./components/fonts.js"
    },
    "./Fonts.astro": "./components/Fonts.astro",
    "./NotFound.astro": "./components/NotFound.astro",
    "./PageShell.astro": "./components/PageShell.astro",
    "./CarouselArrows.astro": "./components/CarouselArrows.astro",
    "./SectionText.astro": "./components/SectionText.astro"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gauthierhien/hien-design-tokens.git"
  },
  "keywords": [
    "design-tokens",
    "brand",
    "tailwind",
    "css",
    "astro-component"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "astro": ">=5",
    "@keystatic/core": ">=0.5",
    "@lucide/astro": ">=1",
    "@paper-design/shaders": ">=0.0.81",
    "swiper": ">=11",
    "ffmpeg-static": ">=5"
  },
  "peerDependenciesMeta": {
    "swiper": {
      "optional": true
    },
    "@keystatic/core": {
      "optional": true
    },
    "ffmpeg-static": {
      "optional": true
    }
  }
}
